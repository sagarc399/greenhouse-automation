# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven build output
backend/target/

# Node / Vite
frontend/node_modules/
frontend/.vite/
frontend/dist/

# Environment / secrets — never commit real credentials
.env
*.env.local
**/.env.local
backend/.env.local

# Local dev launcher scripts (contain credentials)
run-backend.ps1
